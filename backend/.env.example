# ==============================================================================
# graph8 Self-Healing Outbound Agent — Environment Configuration
# ==============================================================================

# graph8 API Key (Obtain from Settings -> API -> Create API Key with scopes per spec)
GRAPH8_API_KEY=your_graph8_api_key_here

# graph8 Base API URL (Verified endpoint from developers doc)
GRAPH8_BASE_URL=https://be.graph8.com/api/v1

# graph8 Webhook Signing Secret (Configured under Settings -> Webhooks in graph8)
GRAPH8_WEBHOOK_SECRET=cqO5HXgTosactTF55ji5x-zOyxpeoSxwtQbwOGHou_Q

# LLM Configuration (OpenAI-compatible client, defaults to Groq)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Supabase Database & Auth (Optional if running in local sandbox SQLite mode)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# Public Webhook Base URL (ngrok or Cloudflare tunnel pointing to your local backend)
WEBHOOK_BASE_URL=https://graph8-hackathon.onrender.com

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Sandbox / Simulation Mode (true allows offline demo simulation if API key is not yet set)
SIMULATION_MODE=false
VOICE_ESCALATION_ENABLED=false
